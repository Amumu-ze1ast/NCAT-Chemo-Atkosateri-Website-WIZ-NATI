---
import { featuredFaculty } from '../data/faculty';
const { heading = true } = Astro.props;
---
<section id="people" aria-labelledby="ppl-h">
  <div class="wrap">
    {heading && (
      <div class="lede"><div><span class="eyebrow">People</span><h2 id="ppl-h">The minds behind the <span class="g">work.</span></h2></div>
        <p><a class="lnk" href="/people">View full directory &rarr;</a></p></div>
    )}
    <div class="pgrid">
      {featuredFaculty.map((p) => (
        <a class="pcard card" href={`/people/${p.slug}`}>{p.photo ? <div class="photo ph has-img"><img src={p.photo} alt={`Portrait of ${p.name}`} loading="lazy" decoding="async" /></div> : <div class="photo ph"><span class="cap">PHOTO</span></div>}<div class="tx"><div class="nm">{p.name}</div><div class="ro">{p.title}</div><div class="ar">{p.areas.join(' · ')}</div></div></a>
      ))}
    </div>
  </div>
</section>
