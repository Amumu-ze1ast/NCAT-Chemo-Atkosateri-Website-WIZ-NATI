---
import { events } from '../data/site';
const { heading = true } = Astro.props;
---
<section style="padding-top:0" aria-labelledby="ev-h">
  <div class="wrap">
    {heading && (
      <div class="lede"><div><span class="eyebrow">Events</span><h2 id="ev-h">What's <span class="g">coming up.</span></h2></div><p><a class="lnk" href="/news">Full calendar &rarr;</a></p></div>
    )}
    <div class="events">
      {events.map((e) => (
        <div class="ev"><div class="date"><div class="d">{e.d}</div><div class="m">{e.m}</div></div><div class="info"><h3>{e.title}</h3><p>{e.meta}</p></div><span class="tag">{e.tag}</span></div>
      ))}
    </div>
  </div>
</section>
