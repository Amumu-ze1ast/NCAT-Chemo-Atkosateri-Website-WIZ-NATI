---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { news } from '../../data/news';
import type { Story } from '../../data/news';

export function getStaticPaths() {
  return news.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
interface Props { s: Story; }
const { s } = Astro.props;
const words = s.body.join(' ').split(/\s+/).length;
const readTime = Math.max(1, Math.round(words / 200));
const more = news.filter((n) => n.slug !== s.slug).slice(0, 2);
---
<SiteLayout title={`${s.title} · Department of Chemistry · NC A&T`} description={s.excerpt}>
  <article class="article">
    <div class="wrap"><nav class="crumb article-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/news">News</a><span>/</span>{s.category}</nav></div>

    <header class={'article-hero' + (s.img ? '' : ' article-hero--plain')}>
      {s.img && <img src={s.img} alt={s.alt} fetchpriority="high" decoding="async" />}
      <div class="wrap">
        <div class="article-headline">
          <div class="article-kicker">
            <span class="pill">{s.category}</span>
            <span class="meta">{s.date} · {readTime} min read</span>
          </div>
          <h1>{s.title}</h1>
          <p class="lead">{s.excerpt}</p>
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="article-col">
        <div class="article-meta2">
          <div class="byline"><b>NC A&amp;T Department of Chemistry</b><span>{s.date}</span></div>
          <div class="share" aria-label="Share this story">
            <button type="button" class="sbtn" id="share-copy" aria-label="Copy link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
            </button>
            <a class="sbtn" id="share-x" href="#" target="_blank" rel="noopener" aria-label="Share on X">X</a>
            <a class="sbtn" id="share-fb" href="#" target="_blank" rel="noopener" aria-label="Share on Facebook">f</a>
          </div>
        </div>

        <div class="article-body prose">
          {s.body.map((p, i) => (
            p.startsWith('NEEDS CONTENT')
              ? <p class="placeholder">{p}</p>
              : <p class={i === 0 ? 'dropcap' : undefined}>{p}</p>
          ))}
          {s.source && <p class="article-src2">Source: <a class="lnk" href={s.source}>ncat.edu &rarr;</a></p>}
        </div>
      </div>
    </div>

    <div class="wrap">
      <aside class="article-more">
        <div class="lede"><div><span class="eyebrow">Keep reading</span><h2>More from the department</h2></div><p><a class="lnk" href="/news">All news &rarr;</a></p></div>
        <div class="ngrid">
          {more.map((a) => (
            <a class="ncard card" href={`/news/${a.slug}`}>
              <div class={a.img ? 'photo ph has-img' : 'photo ph'}>{a.img ? <img src={a.img} alt={a.alt} loading="lazy" decoding="async" /> : <span class="cap">PHOTO</span>}</div>
              <div class="tx"><span class="dt">{a.date} · {a.category}</span><h3>{a.title}</h3><span class="more">Read story &rarr;</span></div>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </article>

  <script>
    const u = encodeURIComponent(location.href);
    const t = encodeURIComponent(document.title.split(' · ')[0]);
    const x = document.getElementById('share-x'); if (x) x.setAttribute('href', 'https://twitter.com/intent/tweet?text=' + t + '&url=' + u);
    const fb = document.getElementById('share-fb'); if (fb) fb.setAttribute('href', 'https://www.facebook.com/sharer/sharer.php?u=' + u);
    const c = document.getElementById('share-copy');
    if (c) c.addEventListener('click', async function () {
      try {
        await navigator.clipboard.writeText(location.href);
        const lab = c.getAttribute('aria-label');
        c.classList.add('copied'); c.setAttribute('aria-label', 'Link copied');
        setTimeout(function () { c.classList.remove('copied'); c.setAttribute('aria-label', lab); }, 1600);
      } catch (e) {}
    });
  </script>
</SiteLayout>
