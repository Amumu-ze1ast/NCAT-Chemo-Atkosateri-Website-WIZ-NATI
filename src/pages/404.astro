---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found · Department of Chemistry · NC A&T">
  <section class="page-head" style="border-bottom:0">
    <div class="wrap">
      <div class="crumb"><a href="/">Home</a><span>/</span>404</div>
      <span class="eyebrow">Error 404 · broken bond</span>
      <h1>This page didn't <span class="g">bond.</span></h1>
      <p>The page you're looking for doesn't exist here. That usually means one of three things: it's still being built (parts of this site are in progress), it lived on the old university page and hasn't been migrated yet, or the link was mistyped. Some destinations — like the application portal, giving, and certain legal pages — live on the main <a class="lnk" href="https://www.ncat.edu/">ncat.edu</a> site rather than here.</p>
    </div>
  </section>
  <section style="padding-top:30px">
    <div class="wrap">
      <div class="lede"><div><span class="eyebrow">Where to next</span><h2>Try one of these</h2></div></div>
      <div class="cardgrid">
        <a class="path card pcardx" href="/"><h3>Home</h3><p>Start from the top.</p><span class="go">Go home &rarr;</span></a>
        <a class="path card pcardx" href="/research"><h3>Research</h3><p>Our five areas and the people behind them.</p><span class="go">Explore research &rarr;</span></a>
        <a class="path card pcardx" href="/people"><h3>People</h3><p>The full faculty & staff directory.</p><span class="go">Find someone &rarr;</span></a>
        <a class="path card pcardx" href="/academics"><h3>Academics</h3><p>Undergraduate & graduate programs.</p><span class="go">See programs &rarr;</span></a>
        <a class="path card pcardx" href="/apply"><h3>Apply</h3><p>Join the department.</p><span class="go">Apply &rarr;</span></a>
        <a class="path card pcardx" href="/contact"><h3>Contact</h3><p>Reach the right person.</p><span class="go">Contact us &rarr;</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
